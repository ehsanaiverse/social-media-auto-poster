# Copy to .env for local settings. Never put real credentials in this file.

# Content folder root. Blank means "data" in this backend folder;
# a relative path is resolved against this backend folder.
AUTOPOSTER_DATA_DIR=

# LinkedIn (used only by `run --real` and `linkedin-check`).
# Create the token in the LinkedIn Developer Portal's token generator, with the
# scopes w_member_social, openid and profile. It lasts 60 days and is not renewed
# automatically: put the date you created it below to get warnings 7 days before
# it expires. Check the setup with: python -m social_media_auto_poster.main linkedin-check
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_TOKEN_CREATED=

# Not used yet: only needed if a login flow inside the app is added later.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
