# Copy to .env for local settings. Never put real credentials in this file.

# Content folder root. Blank means "data" under the directory you run from.
AUTOPOSTER_DATA_DIR=

# LinkedIn app settings. Optional: simulation does not need them, and real
# publishing stays disabled until Milestone 4. Leave blank until then; never
# commit real values.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
